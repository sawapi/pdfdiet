{
  "name": "@sawapi/pdfdiet",
  "version": "0.2.0",
  "description": "Put PDFs on a diet: measured-DPI image downsampling plus lossless font and structure optimization. Permissively-licensed CLI + WASM library for Node and the browser.",
  "license": "(MIT OR Apache-2.0)",
  "bin": {
    "pdfdiet": "./bin/pdfdiet.mjs"
  },
  "main": "./dist/node.mjs",
  "types": "./dist/node.d.mts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "default": {
        "types": "./dist/web.d.mts",
        "default": "./dist/web.mjs"
      }
    },
    "./web": {
      "types": "./dist/web.d.mts",
      "default": "./dist/web.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist/*.mjs",
    "dist/*.d.mts",
    "node",
    "web",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD_PARTY.md"
  ],
  "keywords": [
    "pdf",
    "compress",
    "shrink",
    "optimize",
    "downsample",
    "wasm",
    "lossless",
    "fonts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sawapi/pdfdiet.git",
    "directory": "npm"
  },
  "homepage": "https://sawapi.github.io/pdfdiet/",
  "bugs": {
    "url": "https://github.com/sawapi/pdfdiet/issues"
  },
  "author": "sawapi",
  "scripts": {
    "prepack": "node -e \"for (const f of ['dist/core.mjs','dist/core.d.mts','dist/node.mjs','dist/node.d.mts','dist/web.mjs','dist/web.d.mts','node/pdfdiet_wasm_bg.wasm','web/pdfdiet_wasm_bg.wasm']) require('fs').accessSync(f)\" || (cd .. && ./build-npm.sh)",
    "test": "node test.mjs && tsc -p test-types.tsconfig.json && tsc -p test-types-node.tsconfig.json && tsc -p test-types-bundler.tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
